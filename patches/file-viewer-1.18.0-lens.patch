+#[test]
+fn external_navigation_defers_an_unsaved_note_and_preserves_it_on_its_original_file() {
+    let dir = TempDir::new();
+    std::fs::write(dir.path().join("a.md"), "first").unwrap();
+    std::fs::write(dir.path().join("b.md"), "second").unwrap();
+    let (mut ctrl, _) = controller(dir.path(), false);
+    ctrl.apply_open_target(&herdr_file_viewer::open_target::parse_open_target("a.md").unwrap());
+    ctrl.handle(Intent::AddAnnotation);
+    type_editor(&mut ctrl, "Keep this note on a.md");
+    let path = dir.path().join("request.json");
+    std::fs::write(&path, r#"{"id":"next","target":"b.md"}"#).unwrap();
+    let mut requests =
+        herdr_file_viewer::open_request::OpenRequests::new(path, dir.path().to_path_buf()).unwrap();
+    assert!(
+        requests
+            .poll(ctrl.root(), ctrl.external_open_ready())
+            .is_none()
+    );
+    assert!(ctrl.annotation_editor().is_some());
+    save_editor(&mut ctrl);
+    let request = requests
+        .poll(ctrl.root(), ctrl.external_open_ready())
+        .unwrap();
+    ctrl.apply_preview_request(&request);
+    assert_eq!(
+        ctrl.tree().selected().unwrap().path,
+        dir.path().join("b.md")
+    );
+    let saved = ctrl.annotations().ordered();
+    assert_eq!(saved.len(), 1);
+    assert_eq!(saved[0].target().path(), Path::new("a.md"));
+    assert_eq!(saved[0].text(), "Keep this note on a.md");
