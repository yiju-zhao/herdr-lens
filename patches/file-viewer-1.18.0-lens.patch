@@ -0,0 +1,158 @@
+//! Opt-in, read-only requests to navigate a dedicated viewer within its startup root.
+use crate::open_target::{OpenTarget, parse_open_target_preferring_file, resolve_under_root};
+use serde::Deserialize;
+use std::fs::File;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+pub const REQUEST_ENV: &str = "HERDR_FILE_VIEWER_REQUEST_FILE";
+pub const POLL_INTERVAL: Duration = Duration::from_millis(250);
+const MAX_BYTES: u64 = 16 * 1024;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    id: String,
+    target: String,
+}
+
+pub struct OpenRequests {
+    path: PathBuf,
+    root: PathBuf,
+    seen: Option<String>,
+    pending: Option<OpenTarget>,
+}
+
+impl OpenRequests {
+    pub fn new(path: PathBuf, root: PathBuf) -> Option<Self> {
+        path.is_absolute().then_some(Self {
+            path,
+            root,
+            seen: None,
+            pending: None,
+        })
+    }
+
+    pub fn from_env(root: &Path) -> Option<Self> {
+        Self::new(std::env::var_os(REQUEST_ENV)?.into(), root.to_path_buf())
+    }
+
+    fn read(&self) -> Option<Request> {
+        // Inspect before opening so a named pipe cannot block the event loop.
+        if !std::fs::metadata(&self.path).ok()?.is_file() {
+            return None;
+        }
+        let file = File::open(&self.path).ok()?;
+        if !file.metadata().ok()?.is_file() {
+            return None;
+        }
+        let mut bytes = Vec::new();
+        file.take(MAX_BYTES + 1).read_to_end(&mut bytes).ok()?;
+        if bytes.len() as u64 > MAX_BYTES {
+            return None;
+        }
+        let request: Request = serde_json::from_slice(&bytes).ok()?;
+        if request.id.is_empty()
+            || request.id.len() > 128
+            || request.target.is_empty()
+            || request.target.chars().any(char::is_control)
+        {
+            return None;
+        }
+        Some(request)
+    }
+
+    /// Modals retain input ownership. A root switch suspends the channel.
+    pub fn poll(&mut self, current_root: &Path, ready: bool) -> Option<OpenTarget> {
+        if current_root != self.root {
+            return None;
+        }
+        if let Some(request) = self.read()
+            && self.seen.as_deref() != Some(request.id.as_str())
+        {
+            self.seen = Some(request.id);
+            self.pending = parse_open_target_preferring_file(&request.target, |raw| {
+                resolve_under_root(current_root, raw).is_some_and(|p| p.is_file())
+            })
+            .filter(|target| resolve_under_root(current_root, &target.path).is_some());
+        }
+        if ready { self.pending.take() } else { None }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    struct Fixture(PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            let root = std::env::temp_dir().join(format!(
+                "fv-open-request-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            std::fs::create_dir_all(&root).unwrap();
+            Self(root)
+        }
+        fn write(&self, id: &str, target: &str) {
+            std::fs::write(
+                self.0.join("request.json"),
+                serde_json::to_vec(&serde_json::json!({"id":id,"target":target})).unwrap(),
+            )
+            .unwrap();
+        }
+        fn reader(&self) -> OpenRequests {
+            OpenRequests::new(self.0.join("request.json"), self.0.clone()).unwrap()
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn deduplicates_and_keeps_latest_request_while_modal_is_open() {
+        let f = Fixture::new();
+        let mut reader = f.reader();
+        f.write("1", "first.md");
+        assert!(reader.poll(&f.0, false).is_none());
+        f.write("2", "中文 空格.md:8");
+        assert!(reader.poll(&f.0, false).is_none());
+        let target = reader.poll(&f.0, true).unwrap();
+        assert_eq!(target.path, "中文 空格.md");
+        assert_eq!(target.line, Some(8));
+        assert!(reader.poll(&f.0, true).is_none());
+    }
+
+    #[test]
+    fn malformed_oversized_and_out_of_root_requests_do_not_navigate() {
+        let f = Fixture::new();
+        let mut reader = f.reader();
+        std::fs::write(f.0.join("request.json"), b"{partial").unwrap();
+        assert!(reader.poll(&f.0, true).is_none());
+        f.write("1", "../outside.md");
+        assert!(reader.poll(&f.0, true).is_none());
+        f.write("2", &"x".repeat(MAX_BYTES as usize));
+        assert!(reader.poll(&f.0, true).is_none());
+        f.write("3", "normal.md");
+        assert!(reader.poll(&f.0.join("other-root"), true).is_none());
+        assert_eq!(reader.poll(&f.0, true).unwrap().path, "normal.md");
+    }
+
+    #[test]
+    fn supports_absolute_paths_and_literal_colon_filenames() {
+        let f = Fixture::new();
+        let path = f.0.join("notes:12");
+        std::fs::write(&path, "literal").unwrap();
+        let mut reader = f.reader();
+        f.write("1", path.to_str().unwrap());
+        let target = reader.poll(&f.0, true).unwrap();
+        assert_eq!(target.path, path.to_str().unwrap());
+        assert_eq!(target.line, None);
+    }
+}
