+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::client::shell::tests::{snapshot, surface};
+
+    fn ready() -> (ClientShellState, Box<LensClick>) {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.lens_enabled = true;
+        let mut snapshot = snapshot();
+        snapshot.commands.push(crate::protocol::ClientShellCommand {
+            command_id: "test-lens-command".into(),
+            binding_label: "Ctrl+b, f".into(),
+            binding_labels: vec!["Ctrl+b, f".into()],
+            action: crate::protocol::ClientShellCommandAction::PluginAction,
+            description: Some("Lens: preview file".into()),
+        });
+        state.set_snapshot(Box::new(snapshot));
+        let mut projected = surface();
+        let buffer = Buffer::with_lines(["Done:", "src/report.rs:42:8", ""]);
+        projected.frame = FrameData::from_ratatui_buffer_with_hyperlinks(&buffer, None, &[]);
+        projected.panes[0].inner_rect.width = buffer.area.width;
+        projected.panes[0].inner_rect.height = buffer.area.height;
+        projected.panes[0].rect = projected.panes[0].inner_rect;
+        state.set_pane_surface(projected);
+        state.compose(106, 20).expect("frame");
+        let hit = state.hits.panes[0].clone();
+        let click = state.capture_lens_click(&hit, 1, 3).expect("click");
+        (state, click)
+    }
+
+    #[test]
+    fn lens_click_preserves_source_and_revision_and_drops_old_requests() {
+        let (mut state, click) = ready();
+        let actions = state.request_lens_prefix(click.clone());
+        let [ClientShellAction::Endpoint { request, .. }] = &actions[..] else {
+            panic!("expected read");
+        };
+        assert!(matches!(&request.method,
+            crate::api::schema::Method::PaneSelectionRead(params)
+                if params.pane_id == "pane_1" && params.content_revision == Some(click.revision)));
+        let actions = state.complete_lens_suffix(
+            click.clone(),
+            "Done: src/r".into(),
+            "report.rs:42:8".into(),
+        );
+        let [ClientShellAction::Endpoint { request, .. }] = &actions[..] else {
+            panic!("expected plugin action");
+        };
+        let crate::api::schema::Method::CommandInvoke(params) = &request.method else {
+            panic!("expected Lens action");
+        };
+        assert_eq!(params.command_id, "test-lens-command");
+        assert_eq!(params.pane_id.as_deref(), Some("pane_1"));
+        assert_eq!(params.workspace_id.as_deref(), Some("ws_1"));
+        assert_eq!(
+            params.selection.as_ref().expect("selection").anchor,
+            PaneTextPoint { row: 1, col: 0 }
+        );
+        assert_eq!(
+            params.selection.as_ref().expect("selection").cursor,
+            PaneTextPoint {
+                row: 1,
+                col: "src/report.rs:42:8".len() as u16 - 1
+            }
+        );
+        state.lens_generation += 1;
+        assert!(state
+            .complete_lens_suffix(click, "old.md".into(), "d".into())
+            .is_empty());
+    }
+
+    #[test]
+    fn lens_stale_terminal_read_and_old_machine_reply_never_open_files() {
+        let (mut state, click) = ready();
+        let actions = state.request_lens_prefix(click.clone());
+        let [ClientShellAction::Endpoint { request, .. }] = &actions[..] else {
+            panic!("read");
+        };
+        let (_, actions) = state.handle_endpoint_result(
+            "boot-1",
+            &request.id,
+            Err(ClientShellEndpointError {
+                code: Some("stale_content".into()),
+                message: "changed".into(),
+            }),
+        );
+        assert!(actions.is_empty());
+        let actions = state.request_lens_prefix(click);
+        let [ClientShellAction::Endpoint { request, .. }] = &actions[..] else {
+            panic!("read");
+        };
+        let mut other = snapshot();
+        other.boot_id = "other-machine".into();
+        state.set_snapshot(Box::new(other));
+        let (_, actions) = state.handle_endpoint_result(
+            "boot-1",
+            &request.id,
+            Ok(crate::api::schema::ResponseResult::PaneSelection {
+                pane_id: "pane_1".into(),
+                text: "/old/file.md".into(),
+            }),
+        );
+        assert!(actions.is_empty());
+    }
+
+    #[test]
+    fn lens_suffix_stops_before_unwritten_terminal_padding() {
+        let (mut state, _) = ready();
+        let mut projected = surface();
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 30, 12));
+        buffer.set_string(0, 0, "reports/readme.md", Style::default());
+        projected.frame = FrameData::from_ratatui_buffer_with_hyperlinks(&buffer, None, &[]);
+        projected.panes[0].inner_rect.width = 30;
+        projected.panes[0].inner_rect.height = 12;
+        projected.panes[0].rect = projected.panes[0].inner_rect;
+        state.set_pane_surface(projected);
+        state.compose(106, 20).expect("frame");
+        let hit = state.hits.panes[0].clone();
+        let click = state.capture_lens_click(&hit, 0, 3).expect("click");
+        assert_eq!(click.end_row, 0);
+        assert_eq!(click.end_col, "reports/readme.md".len() as u16 - 1);
+    }
+
+    #[test]
+    fn lens_selection_maps_wide_characters_across_rows_without_padding_spaces() {
+        let (mut state, _) = ready();
+        let mut projected = surface();
+        let buffer = Buffer::with_lines(["/tmp/报", "告.md"]);
+        projected.frame = FrameData::from_ratatui_buffer_with_hyperlinks(&buffer, None, &[]);
+        projected.panes[0].inner_rect.width = buffer.area.width;
+        projected.panes[0].inner_rect.height = buffer.area.height;
+        projected.panes[0].rect = projected.panes[0].inner_rect;
+        state.set_pane_surface(projected);
+        state.compose(106, 20).expect("frame");
+        let hit = state.hits.panes[0].clone();
+        let click = state.capture_lens_click(&hit, 1, 1).expect("click");
+        let selection = state
+            .lens_path_selection(&click, "/tmp/报告.md")
+            .expect("wide path");
+        assert_eq!(selection.anchor, PaneTextPoint { row: 0, col: 0 });
+        assert_eq!(selection.cursor, PaneTextPoint { row: 1, col: 4 });
+    }
+
+    #[test]
+    fn lens_paths_accept_agent_output_unicode_and_line_numbers() {
+        for (text, needle, expected) in [
+            ("Done: src/report.ts:42:8.", "report", "src/report.ts:42:8"),
+            ("已生成 `报告/构建 总结.md`", "总结", "报告/构建 总结.md"),
+            ("Read \"/tmp/a b#c.md\"", "b#", "/tmp/a b#c.md"),
+            ("[报告](reports/summary.md)", "报告", "reports/summary.md"),
+            ("See (/tmp/a(b).md).", "a(b)", "/tmp/a(b).md"),
+            ("file:///tmp/a%20b.md#L2", "%20", "file:///tmp/a%20b.md#L2"),
+            ("README.md", "README", "README.md"),
+        ] {
+            assert_eq!(
+                path_at_byte(text, text.find(needle).expect("needle")).as_deref(),
+                Some(expected),
+                "{text}"
+            );
+        }
+    }
+
+    #[test]
+    fn lens_paths_do_not_claim_web_urls_or_plain_prose() {
+        for text in [
+            "https://example.org/report.md",
+            "hello",
+            "3.14159",
+            "#heading",
+            "--help",
+        ] {
+            assert!(path_at_byte(text, 1).is_none(), "{text}");
+        }
+        assert!(path_at_byte("file.md other.txt", 7).is_none());
+    }
