@@ -0,0 +1,545 @@
+//! Local Lens integration using existing, revision-checked public endpoint methods.
+//! No server replacement or wire-format changes are needed.
+use super::*;
+use crate::api::schema::{PaneSelectionReadParams, PaneTextPoint, PluginInvocationContext};
+use unicode_segmentation::UnicodeSegmentation;
+
+#[derive(Debug, Clone)]
+pub(super) struct LensClick {
+    context: PluginInvocationContext,
+    pane_id: String,
+    row: u32,
+    col: u16,
+    end_row: u32,
+    end_col: u16,
+    revision: u64,
+    generation: u64,
+}
+
+impl ClientShellState {
+    pub(super) fn capture_lens_click(
+        &mut self,
+        hit: &PaneHit,
+        viewport_row: u16,
+        col: u16,
+    ) -> Option<Box<LensClick>> {
+        tracing::debug!(
+            enabled = self.lens_enabled,
+            viewport_row,
+            col,
+            "Lens click capture"
+        );
+        if !self.lens_enabled {
+            return None;
+        }
+        self.lens_generation = self.lens_generation.wrapping_add(1);
+        let snapshot = self.snapshot.as_deref()?;
+        let surface = self.pane_surface.as_ref()?;
+        if surface.boot_id != snapshot.boot_id || surface.projection_revision != snapshot.revision {
+            tracing::debug!("Lens click ignored: projection changed");
+            return None;
+        }
+        let pane = snapshot
+            .panes
+            .iter()
+            .find(|pane| pane.pane_id == hit.pane_id)?;
+        let projected = surface
+            .panes
+            .iter()
+            .find(|pane| pane.pane_id == hit.pane_id)?;
+        let cwd = pane.foreground_cwd.clone().or_else(|| pane.cwd.clone())?;
+        let row = crate::selection::absolute_row_for_viewport(viewport_row, hit.scroll);
+        // Ghostty rejects selections ending in never-written padding rows.
+        // Bound the suffix at the last rendered nonblank cell, using the
+        // source surface (not the sidebar-adjusted composed coordinates).
+        let rect = projected.inner_rect;
+        let mut last = (viewport_row, col);
+        for r in viewport_row
+            ..=viewport_row
+                .saturating_add(8)
+                .min(rect.height.saturating_sub(1))
+        {
+            for c in (if r == viewport_row { col } else { 0 })..rect.width {
+                let x = usize::from(rect.x) + usize::from(c);
+                let y = usize::from(rect.y) + usize::from(r);
+                if x >= usize::from(surface.frame.width) || y >= usize::from(surface.frame.height) {
+                    continue;
+                }
+                if surface
+                    .frame
+                    .cells
+                    .get(y * usize::from(surface.frame.width) + x)
+                    .is_some_and(|cell| !cell.symbol.trim().is_empty())
+                {
+                    last = (r, c);
+                }
+            }
+        }
+        let end_row = crate::selection::absolute_row_for_viewport(last.0, hit.scroll);
+        let context = PluginInvocationContext {
+            workspace_id: Some(pane.workspace_id.clone()),
+            workspace_label: None,
+            workspace_cwd: Some(cwd.clone()),
+            worktree: None,
+            tab_id: Some(pane.tab_id.clone()),
+            tab_label: None,
+            focused_pane_id: Some(pane.pane_id.clone()),
+            focused_pane_cwd: Some(cwd),
+            focused_pane_agent: None,
+            focused_pane_status: None,
+            selected_text: None,
+            invocation_source: Some("lens_ctrl_click".into()),
+            correlation_id: None,
+            clicked_url: None,
+            link_handler_id: None,
+        };
+        Some(Box::new(LensClick {
+            context,
+            pane_id: pane.pane_id.clone(),
+            row,
+            col,
+            end_row,
+            end_col: last.1,
+            revision: projected.content_revision,
+            generation: self.lens_generation,
+        }))
+    }
+
+    pub(super) fn request_lens_prefix(&mut self, click: Box<LensClick>) -> Vec<ClientShellAction> {
+        tracing::debug!(
+            row = click.row,
+            col = click.col,
+            end_row = click.end_row,
+            end_col = click.end_col,
+            revision = click.revision,
+            "Lens prefix request"
+        );
+        if click.generation != self.lens_generation {
+            return Vec::new();
+        }
+        let mut outcome = ClientShellInput::default();
+        self.push_endpoint_method_with_kind(
+            crate::api::schema::Method::PaneSelectionRead(PaneSelectionReadParams {
+                pane_id: click.pane_id.clone(),
+                anchor: PaneTextPoint {
+                    row: click.row.saturating_sub(8),
+                    col: 0,
+                },
+                cursor: PaneTextPoint {
+                    row: click.row,
+                    col: click.col,
+                },
+                content_revision: Some(click.revision),
+            }),
+            PendingEndpointKind::LensPrefix { click },
+            &mut outcome,
+        );
+        outcome.actions
+    }
+
+    pub(super) fn complete_lens_prefix(
+        &mut self,
+        click: Box<LensClick>,
+        prefix: String,
+    ) -> Vec<ClientShellAction> {
+        tracing::debug!(bytes = prefix.len(), "Lens prefix received");
+        if click.generation != self.lens_generation {
+            return Vec::new();
+        }
+        let mut outcome = ClientShellInput::default();
+        self.push_endpoint_method_with_kind(
+            crate::api::schema::Method::PaneSelectionRead(PaneSelectionReadParams {
+                pane_id: click.pane_id.clone(),
+                anchor: PaneTextPoint {
+                    row: click.row,
+                    col: click.col,
+                },
+                cursor: PaneTextPoint {
+                    row: click.end_row,
+                    col: click.end_col,
+                },
+                content_revision: Some(click.revision),
+            }),
+            PendingEndpointKind::LensSuffix { click, prefix },
+            &mut outcome,
+        );
+        outcome.actions
+    }
+
+    pub(super) fn complete_lens_suffix(
+        &mut self,
+        click: Box<LensClick>,
+        prefix: String,
+        suffix: String,
+    ) -> Vec<ClientShellAction> {
+        tracing::debug!(
+            prefix_bytes = prefix.len(),
+            suffix_bytes = suffix.len(),
+            "Lens suffix received"
+        );
+        if click.generation != self.lens_generation {
+            return Vec::new();
+        }
+        let Some((offset, _)) = prefix.grapheme_indices(true).next_back() else {
+            return Vec::new();
+        };
+        let text = format!("{}{}", &prefix[..offset], suffix);
+        let Some(path) = path_at_byte(&text, offset) else {
+            tracing::debug!("Lens click is not a file reference");
+            return Vec::new();
+        };
+        // The stable TUI endpoint exposes command.invoke, not the unrestricted
+        // plugin.action.invoke socket API. Resolve its opaque advertised command
+        // and send a revision-checked selection on the original pane.
+        let command_id = self.snapshot.as_deref().and_then(|snapshot| {
+            snapshot
+                .commands
+                .iter()
+                .find(|command| {
+                    command.action == crate::protocol::ClientShellCommandAction::PluginAction
+                        && command.description.as_deref() == Some("Lens: preview file")
+                })
+                .map(|command| command.command_id.clone())
+        });
+        let Some(command_id) = command_id else {
+            self.set_endpoint_error(
+                "Lens shortcut is not installed on this machine; install Lens and reload config.",
+            );
+            return Vec::new();
+        };
+        let Some(selection) = self.lens_path_selection(&click, &path) else {
+            self.set_endpoint_error("File reference changed or is outside the viewport; select its full path and use Lens.");
+            return Vec::new();
+        };
+        let mut outcome = ClientShellInput::default();
+        self.push_endpoint_method(
+            crate::api::schema::Method::CommandInvoke(crate::api::schema::CommandInvokeParams {
+                command_id,
+                workspace_id: click.context.workspace_id,
+                tab_id: click.context.tab_id,
+                pane_id: Some(click.pane_id),
+                selection: Some(selection),
+            }),
+            &mut outcome,
+        );
+        outcome.actions
+    }
+
+    fn lens_path_selection(
+        &self,
+        click: &LensClick,
+        path: &str,
+    ) -> Option<PaneSelectionReadParams> {
+        let surface = self.pane_surface.as_ref()?;
+        let pane = surface.panes.iter().find(|pane| {
+            pane.pane_id == click.pane_id && pane.content_revision == click.revision
+        })?;
+        let hit = self
+            .hits
+            .panes
+            .iter()
+            .find(|hit| hit.pane_id == click.pane_id)?;
+        let rect = pane.inner_rect;
+        let mut text = String::new();
+        let mut cells = Vec::new();
+        for r in 0..rect.height {
+            let mut covered_until = 0;
+            for c in 0..rect.width {
+                if c < covered_until {
+                    continue;
+                }
+                let x = usize::from(rect.x) + usize::from(c);
+                let y = usize::from(rect.y) + usize::from(r);
+                if x >= usize::from(surface.frame.width) || y >= usize::from(surface.frame.height) {
+                    continue;
+                }
+                let cell = surface
+                    .frame
+                    .cells
+                    .get(y * usize::from(surface.frame.width) + x)?;
+                if cell.skip || cell.symbol.is_empty() {
+                    continue;
+                }
+                covered_until = c.saturating_add(cell.symbol.width().max(1) as u16);
+                let start = text.len();
+                text.push_str(&cell.symbol);
+                cells.push((
+                    start..text.len(),
+                    crate::selection::absolute_row_for_viewport(r, hit.scroll),
+                    c,
+                ));
+            }
+        }
+        let mut matches = Vec::new();
+        for (start, _) in text.match_indices(path) {
+            let end = start + path.len() - 1;
+            let a = cells.iter().find(|(range, _, _)| range.contains(&start))?;
+            let b = cells.iter().find(|(range, _, _)| range.contains(&end))?;
+            let selection = PaneSelectionReadParams {
+                pane_id: click.pane_id.clone(),
+                anchor: PaneTextPoint { row: a.1, col: a.2 },
+                cursor: PaneTextPoint { row: b.1, col: b.2 },
+                content_revision: Some(click.revision),
+            };
+            if (a.1, a.2) <= (click.row, click.col) && (click.row, click.col) <= (b.1, b.2) {
+                return Some(selection);
+            }
+            if a.1 >= click.row.saturating_sub(8) && b.1 <= click.end_row {
+                matches.push(selection);
+            }
+        }
+        if matches.len() == 1 {
+            matches.pop()
+        } else {
+            None
+        }
+    }
+}
+
+fn looks_like_path(path: &str) -> bool {
+    if path.starts_with("file://") {
+        return true;
+    }
+    if path.contains("://") || path.starts_with('#') || path.starts_with('-') {
+        return false;
+    }
+    if path.starts_with('/')
+        || path.starts_with("~/")
+        || path.starts_with("./")
+        || path.starts_with("../")
+    {
+        return path.len() > 1;
+    }
+    if path.contains('/') {
+        return !path.ends_with(':');
+    }
+    let without_line = path.split(':').next().unwrap_or(path);
+    if matches!(
+        without_line,
+        "README" | "LICENSE" | "Makefile" | "Dockerfile" | "AGENTS.md"
+    ) {
+        return true;
+    }
+    without_line.rsplit_once('.').is_some_and(|(stem, ext)| {
+        !stem.is_empty()
+            && !ext.is_empty()
+            && ext.len() <= 12
+            && ext.chars().all(|c| c.is_ascii_alphanumeric())
+            && ext.chars().any(|c| c.is_ascii_alphabetic())
+    })
+}
+
+pub(super) fn path_at_byte(text: &str, clicked: usize) -> Option<String> {
+    // Explicit quoting and Markdown destinations can contain spaces.
+    for pattern in [
+        r"\[[^\]\n]+\]\(([^)\n]+)\)",
+        r#""([^"\n]+)"|'([^'\n]+)'|`([^`\n]+)`"#,
+    ] {
+        let regex = regex::Regex::new(pattern).ok()?;
+        for capture in regex.captures_iter(text) {
+            let whole = capture.get(0)?;
+            if whole.start() <= clicked && clicked < whole.end() {
+                let path = capture.iter().skip(1).flatten().next()?.as_str();
+                if looks_like_path(path) {
+                    return Some(path.to_owned());
+                }
+            }
+        }
+    }
+    let regex = regex::Regex::new(r#"[^\s<>"'`]+"#).ok()?;
+    for found in regex.find_iter(text) {
+        let token = found.as_str();
+        let leading = token.len() - token.trim_start_matches(['[', '(', '{']).len();
+        let mut path = &token[leading..];
+        path = path.trim_end_matches(['.', ',', ';', '!', '?', '。', '，', '；']);
+        while path.ends_with(')') && path.matches(')').count() > path.matches('(').count()
+            || path.ends_with(']') && path.matches(']').count() > path.matches('[').count()
+            || path.ends_with('}') && path.matches('}').count() > path.matches('{').count()
+        {
+            path = &path[..path.len() - 1];
+        }
+        path = path.trim_end_matches('.');
+        let start = found.start() + leading;
+        if start <= clicked && clicked < start + path.len() && looks_like_path(path) {
+            return Some(path.to_owned());
+        }
+    }
+    None
+}
